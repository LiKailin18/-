# ===== 应用 =====
APP_ENV=dev
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Shanghai

# ===== 安全（生产必须换成随机值：python -c "import secrets;print(secrets.token_urlsafe(48))"）=====
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/smart_learning
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== 文件上传 =====
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=20

# ===== 大模型（只放后端，禁止提交真实 Key）=====
# 主用：通义千问（DashScope 的 OpenAI 兼容端点）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 主用模型：qwen-plus（也可用 qwen-turbo / qwen-max）
# 备用（同样通过三项能力探针，改注释即可切换）：
#   智谱：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   DeepSeek：LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_STEPS=12
AI_AGENT_TIMEOUT=90
AI_USE_DEEP_AGENT=false
AI_ENABLE_NOTE_TOOL=false
AI_DAILY_QUOTA=100

# ===== CORS（仅开发需要；生产由 nginx 同源代理，不产生跨域）=====
# 同时用于 refresh/logout 的 Origin 校验，localhost 与 127.0.0.1 都要列
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
